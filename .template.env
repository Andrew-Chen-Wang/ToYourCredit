SENTRY_SUPPRESS_TURBOPACK_WARNING=1
NEXT_PUBLIC_HOST_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_HOSTNAME=localhost
API_PORT=3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VALKEY_URL=redis://localhost:60532
ELASTICSEARCH_URL=http://localhost:49317
S3_ENDPOINT=http://localhost:52246
S3_REGION=garage
S3_BUCKET_NAME=readit-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUBLIC_MEDIA_BASE_URL=http://readit-media.web.garage.localhost:58614

# --- Feed ingestion (bullground) ---
# Account new link posts are attributed to. In development, if this user does not exist the job
# falls back to the first user in the database; in production it posts nothing instead.
FEED_BOT_USERNAME=acwangpython
# Optional. When set, Claude decides which community an article belongs in (it reads the article
# body or video transcript). Without it, ingestion falls back to the keyword classifier.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional. Model used for that classification. Defaults to claude-opus-5; set
# claude-haiku-4-5 to trade some accuracy for a much lower per-article cost.
FEED_CLASSIFIER_MODEL=
